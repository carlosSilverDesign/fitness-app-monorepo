// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// ------------------------------------------------------
// CONFIGURACIÓN PRINCIPAL
// ------------------------------------------------------
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS (Listas de valores permitidos)
// ------------------------------------------------------
enum Role {
  FREE
  PREMIUM
  TRAINER
  ADMIN
}

// ------------------------------------------------------
// MODELOS PRINCIPALES (Tablas)
// ------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(FREE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relaciones (Un usuario tiene...)
  profile      Profile?
  measurements Measurement[] // Muchas mediciones a lo largo del tiempo
  routines     Routine[]     // Muchas rutinas asignadas o creadas
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  gender      String?
  heightCm    Float?
  dateOfBirth DateTime?

  // NUEVOS CAMPOS: Perfil Integral del Atleta
  phone             String?
  activityLevel     String?   // Ej: SEDENTARIO, ACTIVO, ATLETA (Lo que hace)
  dietPreference    String?   // Ej: VEGANA, KETO, FLEXIBLE (Lo que come)
  fitnessGoals      String?   // Ej: PERDER_GRASA, GANAR_MASA (Objetivos)
  medicalConditions String?   // Ej: ASMA, LESION_RODILLA (Condición médica)
}

// NUEVO: Tabla de Progresión Física (Fase 2)
model Measurement {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date              DateTime @default(now()) // Fecha de la medición
  
  // Datos Generales
  weightKg          Float?

  // METADATOS CIENTÍFICOS (Lo que nos hace los mejores)
  formulaUsed       String?  // Ej: "JACKSON_POLLOCK_7", "DURNIN_WOMERSLEY"
  bodyDensity       Float?   // La Db intermedia que calculamos
  bodyFatPercentage Float?   // El %BF final (Siri)

  // RESULTADOS DERIVADOS (Lo que el Trainer quiere ver)
  fatMassKg         Float?   // (weightKg * bodyFatPercentage) / 100
  fatFreeMassKg     Float?   // weightKg - fatMassKg
  
  // Perímetros (en centímetros)
  waistCm           Float?
  hipCm             Float?

  // NUEVOS CAMPOS: Los 8 Pliegues Cutáneos (en milímetros - mm)
  tricepFold        Float?
  pectoralFold      Float?
  abdominalFold     Float?
  thighFold         Float?
  bicepFold         Float?       // Necesario para Durnin & Womersley
  subscapularFold   Float?       // Necesario para J&P 7 y D&W
  suprailiacFold    Float?       // Necesario para J&P 3/4/7 y D&W
  midaxillaryFold   Float?       // Necesario para J&P 7

  createdAt         DateTime @default(now())
}

// NUEVO: Tabla de Rutinas (Fase 3)
model Routine {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String   // Ej: "Día 1: Pecho y Tríceps"
  description String?  // Ej: "Rutina enfocada en hipertrofia"
  level       String?  // Ej: "PRINCIPIANTE", "AVANZADO"
  isPremium   Boolean  @default(false) // Aquí está la clave para bloquear contenido
  
  items       RoutineItem[] // Conexión con los ejercicios
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// NUEVO: Ejercicios dentro de una Rutina (Fase 3)
model RoutineItem {
  id          String   @id @default(uuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  
  exercise    String   // Ej: "Press de Banca Plano"
  sets        Int      // Ej: 4
  reps        String   // Usamos String por si escriben "10-12" o "Al fallo"
  restSeconds Int?     // Ej: 90 (segundos de descanso)
  notes       String?  // Ej: "Bajar lento, explosivo al subir"
}

// Modelo para los testimonios de la Landing Page
model Testimonial {
  id          String   @id @default(uuid())
  name        String
  achievement String   // Ej: "-15kg de grasa" o "+5kg de músculo"
  content     String   @db.Text
  imageUrl    String?  // URL de la foto del antes/después o avatar
  order       Int      @default(0) // Para decidir cuál aparece primero
  createdAt   DateTime @default(now())
}